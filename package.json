{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/server.js",
    "backup": "node --env-file-if-exists=.env server/backup.js",
    "clear:messages": "node --env-file-if-exists=.env server/clearMessages.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "seed:loading": "node --env-file-if-exists=.env server/seedLoading.js",
    "seed:handover": "node --env-file-if-exists=.env server/seedHandover.js",
    "seed:security": "node --env-file-if-exists=.env server/seedSecurity.js",
    "seed:priority": "node --env-file-if-exists=.env server/seedPriority.js",
    "snapshot": "node --env-file-if-exists=.env server/snapshot.js save",
    "seed:snapshot": "node --env-file-if-exists=.env server/snapshot.js load",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=88 --test-coverage-branches=90 --test-coverage-functions=83",
    "test:e2e": "vite build && playwright test",
    "typecheck": "tsc -p jsconfig.json --checkJs",
    "knip": "knip",
    "format": "prettier --write",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
