# Copy to .env and adjust.

# ---------- Browser (VITE_* values are built into the site, so never put secrets here) ----------

# Where the backend API lives.
# Same server (default, recommended): /api
# Separate server on the company network: http://192.168.1.10:3000/api
VITE_API_URL=/api

# ---------- Server only (read by npm run dev / npm start; never sent to the browser) ----------

# The built-in admin account: created at the first start, and its password always comes from here.
# Create the sales staff's accounts in Admin → Accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Folder for the database (queue.db), the uploaded display video and backups.
# Default: data\ inside this project. On the Windows server, keep it outside the app folder
# so updating the app never touches the data:
# DATA_DIR=C:\SheehanQueue\data

# Where npm run backup saves copies (default: backups\ in DATA_DIR). Use another drive on the server.
# BACKUP_DIR=D:\SheehanQueue\backups

# Port for npm start (default 3000)
# PORT=3000
